# ==============================================================================
# CONFIGURAÇÕES GERAIS DA STACK (HOST E CONTAINERS)
# ==============================================================================
PUID=1001
PGID=1001
TZ=America/Sao_Paulo
STACK_DIR=/srv/jellyfin
CONFIG_DIR=/srv/jellyfin/config
DATA_DIR=/srv/jellyfin/data

# ==============================================================================
# TRAEFIK, REDE, DNS E PORTAS EXPOSTAS
# ==============================================================================
APP_HOST=flix.home.ensilva.cc
SEERR_HOST=flix-search.home.ensilva.cc

# Bind para serviços UDP locais (descoberta automática do Jellyfin na LAN)
PUBLIC_BIND_IP=0.0.0.0
JELLYFIN_DISCOVERY_PORT=7359

# Porta P2P do BitTorrent exposta no host (TCP/UDP)
QBIT_TORRENT_PORT=6881

# Servidores DNS aplicados aos containers sem VPN (o Gluetun usa DoT interno próprio)
DNS_PRIMARY=1.1.1.1
DNS_SECONDARY=8.8.8.8

# Sub-rede fixa da bridge interna media_net (evita conflitos com VPNs e LAN)
DOCKER_SUBNET=172.28.0.0/24

# ==============================================================================
# CHAVES DE API INTERNAS (GERENCIADAS PELA STACK)
# ==============================================================================
PROWLARR_API_KEY=11111111111111111111111111111111
RADARR_API_KEY=22222222222222222222222222222222
SONARR_API_KEY=33333333333333333333333333333333
BAZARR_API_KEY=44444444444444444444444444444444

# ==============================================================================
# VPN (GLUETUN + SURFSHARK) E QBITTORRENT
# ==============================================================================
# Use "gluetun" quando o túnel VPN estiver ativo ou "qbittorrent" para conexão direta
QBIT_HOST=gluetun

# Interface de rede do kill-switch no qBittorrent (vazio = automático: "tun0" se QBIT_HOST=gluetun)
QBIT_NETWORK_INTERFACE=

VPN_SERVICE_PROVIDER=surfshark
VPN_TYPE=wireguard
VPN_SERVER_COUNTRIES=Brazil

# Credenciais WireGuard (Surfshark -> VPN -> Manual Setup -> WireGuard)
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=10.14.0.2/16

# Credenciais OpenVPN (apenas se VPN_TYPE=openvpn; use as credenciais de serviço)
OPENVPN_USER=
OPENVPN_PASSWORD=

# Sub-redes liberadas sem autenticação na WebUI do qBittorrent (acesso via rede interna)
QBIT_AUTH_SUBNET_WHITELIST=172.28.0.0/24
# Senha com no mínimo 6 caracteres
QBIT_ADMIN_USER=admin
QBIT_ADMIN_PASS=

# ==============================================================================
# JELLYFIN (ORANGE PI 5 PRO / RK3588S) E SEERR
# ==============================================================================
JELLYFIN_SERVER_NAME=HomeFlix
JELLYFIN_ADMIN_USER=admin
JELLYFIN_ADMIN_PASS=
JELLYFIN_UI_CULTURE=en-US
JELLYFIN_METADATA_COUNTRY=US
JELLYFIN_METADATA_LANG=en
JELLYFIN_MONITOR_DELAY=10

# Aceleração de hardware para transcodificação: "rkmpp" (Rockchip RK3588/RK3588S) ou "" (desativado)
JELLYFIN_HWACCEL=rkmpp

SEERR_DEFAULT_PROFILE_ID=4
SEERR_DEFAULT_PROFILE_NAME=HD-1080p

# ==============================================================================
# PROWLARR, RADARR E SONARR (INDEXADORES, ÁUDIO E LIMITE DE TAMANHO)
# ==============================================================================
ARR_ADMIN_USER=admin
ARR_ADMIN_PASS=

PROWLARR_INDEXERS="YTS,Knaben,The Pirate Bay,RuTor"
PROWLARR_MIN_SEEDERS=2

# Bloqueia lançamentos dublados/dual-audio e exige apenas o idioma original da obra
AUDIO_ORIGINAL_ONLY=true

# Taxa máxima em MB/min (48 MB/min ≈ 8 GB para filmes de ~2h45 e séries de ~60 min)
RADARR_MAX_SIZE_MB_MIN=48.0
SONARR_MAX_SIZE_MB_MIN=48.0

# ==============================================================================
# BAZARR (LEGENDAS E PROVEDORES)
# ==============================================================================
BAZARR_LANGUAGES=pb,en
BAZARR_PROFILE_NAME="pt-BR + EN"
BAZARR_ALLOW_HI=Include
BAZARR_MIN_SCORE_MOVIE=60
BAZARR_MIN_SCORE_SERIES=70
BAZARR_AUTO_SYNC=true
BAZARR_DEFAULT_PROVIDERS=embeddedsubtitles,yifysubtitles,tvsubtitles,podnapisi,gestdown

# Deixe vazio para herdar ARR_ADMIN_USER e ARR_ADMIN_PASS automaticamente
BAZARR_ADMIN_USER=
BAZARR_ADMIN_PASS=

# Credenciais opcionais de provedores externos de legendas
OPENSUBTITLES_USER=
OPENSUBTITLES_PASS=
SUBSOURCE_API_KEY=